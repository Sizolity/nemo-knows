# nemocli wiki-root environment template.
#
# Copy this file to .env in the same directory ($WIKI_ROOT/.env) and fill
# in the secrets locally. nemocli loads $WIKI_ROOT/.env at startup, before
# resolving the model provider, so values placed here override the
# in-process defaults. Do not commit a populated .env to git.
#
# Required for the default DeepSeek backend. Leave the value empty here
# and fill it in your private $WIKI_ROOT/.env.
NEMO_MODEL_PROVIDER=deepseek
NEMO_DEEPSEEK_API_KEY=

# Optional DeepSeek overrides. internal/config supplies safe defaults
# (deepseek-v4-pro, 1M-token context, retry on transient errors), so
# leave these commented unless you know you want to change them.
# NEMO_DEEPSEEK_BASE_URL=
# NEMO_DEEPSEEK_MODEL=
# NEMO_DEEPSEEK_MAX_TOKENS=
# NEMO_DEEPSEEK_THINKING=
# NEMO_DEEPSEEK_REASONING_EFFORT=

# Llama backend (only honored when NEMO_MODEL_PROVIDER=llama). Both
# variables are required for the llama backend; nemocli refuses to run
# ingest under provider=llama unless both are non-empty.
# NEMO_LLAMA_CLI=
# NEMO_LLAMA_MODEL=

# Optional runtime knobs (nemocli's own state lives at
# $XDG_STATE_HOME/nemo/ or ~/.local/state/nemo/).
# NEMO_WIKI_ROOT=
# NEMO_ONCE_MODE=safe
# NEMO_RUNS_RETENTION_DAYS=30
# NEMO_CHECKPOINT_RETENTION_DAYS=7
