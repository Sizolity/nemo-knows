pipeline/evals/runs/

# Full llama.cpp traces next to cleaned bundle/candidate drafts (regenerate locally)
pipeline/drafts/**/*.raw.txt
pipeline/drafts/**/*.fallback.raw.txt

# Local web console runtime log
web.log

# Server-side deployment state
.deploy-state/
.releases/

# Local test scratch space
tmp/

# Runtime-regenerated wiki pages. Keep only the required wiki skeleton in Git:
# wiki/index.md, wiki/log.md, directory placeholders, and explicitly promoted
# source pages.
wiki/sources/*
wiki/entities/*
wiki/concepts/*
wiki/topics/*
wiki/assets/*
!wiki/sources/.gitkeep
!wiki/sources/llm-wiki.md
!wiki/sources/git-branching.md
!wiki/sources/qwen-llama-cpp.md
!wiki/sources/sqlite-wal.md
!wiki/entities/.gitkeep
!wiki/concepts/.gitkeep
!wiki/topics/.gitkeep
!wiki/assets/.gitkeep
# Promoted demo assets for the image-assets capability (real MIT 6.004 slides).
# The directory must be re-included before its files can be tracked, since
# wiki/assets/* ignores the subdirectory itself.
!wiki/assets/c10s1-slides/
!wiki/assets/c10s1-slides/Slide02.png
!wiki/assets/c10s1-slides/Slide03.png
!wiki/assets/c10s1-slides/Slide04.png
!wiki/assets/c10s1-slides/Slide05.png
!wiki/assets/c10s1-slides/Slide06.png
scratch/
